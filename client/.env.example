# ==========================================================
#  Notes Heaven - Frontend env
#  Copy karke `.env` banao
# ==========================================================

# LOCAL DEV: khaali chhodo -> Vite "/api" ko localhost:5000 par proxy kar dega
VITE_API_URL=

# PRODUCTION (Vercel): Render backend ka pura URL
# VITE_API_URL=https://notes-heaven-api.onrender.com

# Vite dev proxy target (jab backend dusre port par chale)
VITE_PROXY_TARGET=http://localhost:5000

# Demo mode: true -> bina backend ke sample data ke saath UI chalega (sirf dikhane ke liye)
VITE_DEMO_MODE=false
